{
    "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/cache",
            "!**/coverage",
            "!**/tsconfig.json",
            "!**/tsconfig.*.json",
            "!**/_cjs",
            "!**/_esm",
            "!**/_types",
            "!**/bun.lockb",
            "!**/temp.ts"
        ]
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "error"
            },
            "style": {
                "noUnusedTemplateLiteral": "warn"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": true,
        "lineWidth": 80,
        "indentWidth": 4,
        "indentStyle": "space"
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "trailingCommas": "none"
        }
    },
    "overrides": [
        {
            "includes": ["**/*.test.ts", "**/*.test-d.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        }
    ]
}
