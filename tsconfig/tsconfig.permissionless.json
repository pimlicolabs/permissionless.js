{
    // This file is used to compile for esm (see package.json build scripts). It should exclude all test files.
    "extends": "./tsconfig.base.json",
    "include": [
        "../packages/permissionless"
    ],
    "exclude": [
        "../packages/permissionless/_esm",
        "../packages/permissionless/_types",
        "../packages/permissionless-test/*",
        "../packages/permissionless/**/setupTests.ts",
        "../packages/permissionless/**/*.test.ts",
        "../packages/permissionless/**/*.test-d.ts",
        "../packages/permissionless/**/*.bench.ts",
        "../packages/permissionless/vitest.config.ts"
    ],
    "compilerOptions": {
        "sourceMap": true,
        "rootDir": "../packages/permissionless"
    }
}