{
    "workspaces": [
        "packages/permissionless",
        "packages/wagmi",
        "packages/wagmi-demo",
        "packages/mock-paymaster"
    ],
    "private": true,
    "author": "Pimlico",
    "type": "module",
    "sideEffects": false,
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@changesets/changelog-git": "^0.1.14",
        "@changesets/changelog-github": "^0.4.8",
        "@changesets/cli": "^2.26.2",
        "@permissionless/wagmi": "workspace:packages/wagmi",
        "@pimlico/mock-paymaster": "workspace:packages/mock-paymaster",
        "@pimlico/alto": "^0.0.19",
        "@size-limit/esbuild-why": "^9.0.0",
        "@size-limit/preset-small-lib": "^9.0.0",
        "@tanstack/react-query": "5.45.1",
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/coverage-v8": "^2.1.5",
        "@wagmi/cli": "latest",
        "async-mutex": "^0.5.0",
        "buffer": "^6.0.3",
        "bun-types": "^1.0.7",
        "get-port": "^7.0.0",
        "prool": "^0.0.25",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "rimraf": "^6.0.1",
        "simple-git-hooks": "^2.9.0",
        "size-limit": "^9.0.0",
        "typescript": "7.0.2",
        "typescript5": "npm:typescript@5.9.3",
        "viem": "3.0.0-next.10",
        "vite": "^5.4.10",
        "vitest": "^2.1.5",
        "wagmi": "^2.15.1",
        "@wagmi/core": "2.17.1"
    },
    "description": "",
    "keywords": [],
    "license": "MIT",
    "scripts": {
        "build": "(bun run build:permissionless & p1=$!; bun run build:wagmi & p2=$!; bun run build:mock-paymaster & p3=$!; wait $p1 && wait $p2 && wait $p3)",
        "build:ci": "bun run build:permissionless && bun run build:wagmi && bun run build:mock-paymaster",
        "build:permissionless": "bun run clean:permissionless && tsc --project ./tsconfig/tsconfig.permissionless.esm.json",
        "build:wagmi": "bun run clean:wagmi && tsc --project ./tsconfig/tsconfig.wagmi.esm.json",
        "build:mock-paymaster": "bun run clean:mock-paymaster && tsc --project ./tsconfig/tsconfig.mock-paymaster.esm.json",
        "build:size": "bun run build:permissionless",
        "clean": "bun run clean:permissionless && bun run clean:wagmi && bun run clean:mock-paymaster",
        "clean:permissionless": "rimraf ./packages/permissionless/_esm ./packages/permissionless/_types",
        "clean:wagmi": "rimraf ./packages/wagmi/_esm ./packages/wagmi/_types",
        "clean:mock-paymaster": "rimraf ./packages/mock-paymaster/_esm ./packages/mock-paymaster/_types",
        "changeset": "changeset",
        "changeset:release": "bun run build && changeset publish",
        "changeset:version": "changeset version && bun install --lockfile-only",
        "format": "biome format . --write",
        "lint": "biome check .",
        "lint:fix": "bun run lint --write",
        "test": "vitest dev -c ./packages/permissionless/vitest.config.ts",
        "test:ci-no-coverage": "CI=true && vitest -c ./packages/permissionless/vitest.config.ts --pool=forks",
        "test:ci": "CI=true && vitest -c ./packages/permissionless/vitest.config.ts --coverage --pool=forks",
        "wagmi-demo": "bun run --cwd packages/wagmi-demo dev"
    },
    "simple-git-hooks": {
        "pre-commit": "bun run format && bun run lint:fix"
    }
}
