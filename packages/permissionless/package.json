{
    "name": "permissionless",
    "version": "0.4.1",
    "author": "Pimlico",
    "homepage": "https://docs.pimlico.io/permissionless",
    "repository": "github:pimlicolabs/permissionless.js",
    "main": "./_esm/index.js",
    "module": "./_esm/index.js",
    "types": "./_types/index.d.ts",
    "typings": "./_types/index.d.ts",
    "type": "module",
    "sideEffects": false,
    "description": "A utility library for working with ERC-4337",
    "keywords": [
        "ethereum",
        "erc-4337",
        "eip-4337",
        "paymaster",
        "bundler"
    ],
    "license": "MIT",
    "files": [
        "*",
        "!**/*.test.ts",
        "!**/*.test.ts.snap",
        "!**/*.test-d.ts",
        "!**/*.bench.ts",
        "!**/setupTests.ts",
        "!**/*.tsbuildinfo",
        "!vitest.config.ts",
        "!coverage"
    ],
    "exports": {
        ".": {
            "types": "./_types/index.d.ts",
            "default": "./_esm/index.js"
        },
        "./pimlico": {
            "types": "./_types/pimlico/index.d.ts",
            "default": "./_esm/pimlico/index.js"
        },
        "./etherspot": {
            "types": "./_types/etherspot/index.d.ts",
            "default": "./_esm/etherspot/index.js"
        },
        "./experimental": {
            "types": "./_types/experimental/index.d.ts",
            "default": "./_esm/experimental/index.js"
        },
        "./package.json": "./package.json",
        "./_types/*": {
            "types": "./_types/*.d.ts",
            "default": "./_esm/*.js"
        }
    },
    "typesVersions": {
        "*": {
            "pimlico": [
                "./_types/pimlico/index.d.ts"
            ],
            "etherspot": [
                "./_types/etherspot/index.d.ts"
            ],
            "experimental": [
                "./_types/experimental/index.d.ts"
            ]
        }
    },
    "peerDependencies": {
        "viem": "^3.0.0-next.10",
        "typescript": ">=5.9.0"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    }
}
